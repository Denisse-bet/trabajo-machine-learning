    // Endpoint existente
    @GetMapping("/recomendaciones")
    public List<Pelicula> obtenerRecomendaciones(@RequestParam(required = false) String genero) {
        // Filtrar por género si se proporciona
        List<Pelicula> recomendaciones = // Llamar a lógica de recomendación
        if (genero != null && !genero.isEmpty()) {
            recomendaciones = recomendaciones.stream()
                .filter(p -> p.getGeneros().contains(genero))
                .collect(Collectors.toList());
        }
        return recomendaciones;
    }

