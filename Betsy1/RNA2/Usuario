public class Usuario {
    private int id;
    private List<Pelicula> historial;
    private Map<String, Double> preferencias; // e.g., {"Accion": 4.5}
    private double tiempoVisualizacionPromedio;
    // Constructor, getters y setters
    public Usuario(int id) {
        this.id = id;
        this.historial = new ArrayList<>();
        this.preferencias = new HashMap<>();
    }
}
public class Pelicula {
    private int id;
    private String titulo;
    private List<String> generos;
    private double ratingPromedio;
    private Map<String, Double> caracteristicas; // e.g., {"Accion": 0.8}
    // Constructor, getters y setters
    public Pelicula(int id, String titulo) {
        this.id = id;
        this.titulo = titulo;
        this.generos = new ArrayList<>();
        this.caracteristicas = new HashMap<>();
    }
}